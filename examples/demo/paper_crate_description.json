{
  "name": "Nuclei counting in 2D fluorescence images (Fiji)",
  "description": "Counts nuclei per field and their mean area. Otsu threshold, particles of at least 50 pixels kept to exclude debris. Synthetic demo standing in for a paper.",
  "identifier": "https://example.org/recrate-demo/nuclei-counting/v1",
  "citation": "https://doi.org/10.0000/recrate-demo-paper",
  "license": "https://spdx.org/licenses/CC-BY-4.0",
  "authors": [
    "ReCRATE demo"
  ],
  "profile": "bioimaging",
  "workflow": {
    "file": "paper_crate/count_nuclei.ijm",
    "language": "ImageJ Macro Language",
    "software": [
      {
        "name": "Fiji",
        "version": "2.16.0"
      }
    ]
  },
  "inputs": [
    {
      "id": "in-images",
      "name": "input_dir",
      "type": "File",
      "format": "image/tiff",
      "description": "2D single-channel fluorescence images of nuclei, calibrated",
      "properties": {
        "pixel size": {
          "value": 0.65,
          "unit": "µm"
        },
        "channels": {
          "value": 1
        },
        "dimensions": {
          "value": "2D"
        }
      }
    },
    {
      "id": "in-threshold",
      "name": "threshold_method",
      "type": "Text",
      "default": "Otsu",
      "description": "ImageJ auto-threshold method"
    },
    {
      "id": "in-min-size",
      "name": "min_size_px",
      "type": "Float",
      "default": 50,
      "description": "Minimum particle area in pixels; removes debris",
      "scaling": "inverse_pixel_area"
    }
  ],
  "outputs": [
    {
      "id": "out-results",
      "name": "results",
      "type": "File",
      "format": "text/csv",
      "description": "One row per image: count and mean area (µm²)",
      "tolerances": {
        "count": 0.05,
        "mean_area": 0.1
      }
    }
  ],
  "example_data": "paper_crate/data",
  "expected": "paper_crate/expected/results.csv"
}